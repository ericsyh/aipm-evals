# Export these environment variables before starting the server.
HOST=127.0.0.1
PORT=4310
STORAGE_DRIVER=file
DATA_DIR=./data
# Set a token when accepting collector traffic. Never put this in frontend code.
INGEST_TOKEN=
# Runtime rule overrides default to DATA_DIR/rules.json; initialized from config/default-rules.json.
RULES_FILE=./data/rules.json
# Native hook capture options (content transfer must be explicitly enabled).
PM_SIGNAL_MEMBER_ID=local-pm
PM_SIGNAL_ENDPOINT=http://127.0.0.1:4310/api/observations
PM_SIGNAL_CAPTURE_CONTENT=0
# Explicit kill switch for capture (0/off/false: no network request or stdin processing).
# PM_SIGNAL_TELEMETRY=off
# Consent preferences are kept outside the event store.
PRIVACY_FILE=./data/privacy.json
TEAM_MIN_PARTICIPANTS=3
# Optional private workspace capability; local browser cookie is generated if unset.
PERSONAL_TOKEN=
# For Elasticsearch, set STORAGE_DRIVER=elasticsearch.
ES_URL=http://localhost:9200
ES_INDEX=aipm-events
ES_API_KEY=
